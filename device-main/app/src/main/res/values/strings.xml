    <!-- Rationale dialogs -->
    <string name="rationale_phone_title" translatable="false">அனுமதி தேவை / Permission Required</string>
    <string name="rationale_phone_body" translatable="false">உங்கள் நெட்வொர்க்கில் ஏற்படும் 5G / 4G / 3G / 2G மாற்றங்களைக் கண்டறிய தொலைபேசி நிலை அனுமதி தேவை. உங்கள் தொலைபேசி எண் அல்லது தனிப்பட்ட தகவல்கள் எதுவும் படிக்கப்படாது.\n\nPhone State permission is needed to detect 5G / 4G / 3G / 2G changes. No phone number or personal data is read.</string>
    <string name="rationale_notification_title" translatable="false">அறிவிப்பு அனுமதி / Notification Permission</string>
    <string name="rationale_notification_body" translatable="false">பின்னணியில் கண்காணிப்பு தொடர்ந்து செயல்பட ஒரு நிலையான அறிவிப்பு காட்டப்படும்.\n\nA quiet, static notification keeps monitoring running in the background.</string>
    <string name="rationale_grant_button" translatable="false">அனுமதி வழங்கவும் / Grant</string>
    <string name="rationale_cancel_button" translatable="false">பிறகு / Not Now</string>

